{
	// symbols used for commenting
	"comments": {
		"lineComment": "--",
		"blockComment": [ "--[[", "]]" ]
	},
	// symbols used as brackets
	"brackets": [
		["{", "}"],
		["[", "]"],
		["(", ")"]
	],
	// symbols that are auto closed when typing
	"autoClosingPairs": [
		["{", "}"],
		["[", "]"],
		["(", ")"],
		["'", "'"],
		["\"", "\""]
	],
	// symbols that can be used to surround a selection
	"surroundingPairs": [
		["{", "}"],
		["[", "]"],
		["(", ")"],
		["'", "'"],
		["\"", "\""],
		["<", ">"]
	],
	"colorizedBracketPairs": [
		["(", ")"],
		["[", "]"],
		["{", "}"]
	],
	"autoCloseBefore": ";:.,=}])> \n\t",
	"folding": {
		"offSide": true
	},
	"onEnterRules": [
		// Block-opening do and function arrows, including trailing line comments.
		{
			"beforeText": "^(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|[^\"'\\-]|-(?!-))*?(?:\\bdo|->|=>)[ \\t]*(?:--.*)?$",
			"action": {
				"indent": "indent"
			}
		},
		// Only unquoted then/do with a body marks a completed inline statement.
		{
			"beforeText": "^(?:\"(?:\\\\.|[^\"\\\\])*\"|'(?:\\\\.|[^'\\\\])*'|[^\"'\\-]|-(?!-))*?\\b(?:then|do)\\b[ \\t]+(?![ \\t]|--|$).*$",
			"action": {
				"indent": "none"
			}
		},
		// until closes repeat; return can introduce a nested block expression.
		{
			"beforeText": "^[ \\t]*(?:return[ \\t]+)?(?:if|unless|elseif|when|else|for|while|switch|do|repeat|catch|try|with|class)\\b.*$",
			"action": {
				"indent": "indent"
			}
		},
		// Only bare terminal statements outdent; return values and open brackets use normal indentation.
		{
			"beforeText": "^[ \\t]*(?:return|continue|break)[ \\t]*(?:--.*)?$",
			"action": {
				"indent": "outdent"
			}
		}
	]
}
