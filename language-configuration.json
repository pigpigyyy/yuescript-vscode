{
	// symbols used for commenting
	"comments": {
		"lineComment": "--",
		"blockComment": [ "--[[", "]]" ]
	},
	// symbols used as brackets
	"brackets": [
		["{", "}"],
		["[", "]"],
		["(", ")"]
	],
	// symbols that are auto closed when typing
	"autoClosingPairs": [
		["{", "}"],
		["[", "]"],
		["(", ")"],
		["'", "'"],
		["\"", "\""]
	],
	// symbols that can be used to surround a selection
	"surroundingPairs": [
		["{", "}"],
		["[", "]"],
		["(", ")"],
		["'", "'"],
		["\"", "\""],
		["<", ">"]
	],
	"colorizedBracketPairs": [
		["(", ")"],
		["[", "]"],
		["{", "}"]
	],
	"autoCloseBefore": ";:.,=}])> \n\t",
	"folding": {
		"offSide": true
	},
	"onEnterRules": [
		{
			"beforeText": "^\\s*(if|else|elseif|when|until|for|while|switch|do|repeat|catch|try|with|class)\\b.*$",
			"action": {
				"indent": "indent"
			}
		},
		{
			"beforeText": "(do|->)\\s*$",
			"action": {
				"indent": "indent"
			}
		},
		{
			"beforeText": "^\\s*(return)\\b.*$",
			"action": {
				"indent": "outdent"
			}
		},
		{
			"beforeText": "^\\s*(return|continue|break)\\s*$",
			"action": {
				"indent": "outdent"
			}
		},
	]
}
