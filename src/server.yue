import "yue"
const json = do
	local success, result

	if success, result := pcall require, "cojson"
		result
	elseif success, result := pcall require, "cjson"
		result
	elseif success, result := pcall require, "json"
		result
	else
		error "Could not find a JSON-module for YueScript! Please install one."

local formatter

const rewriteLua = (code) ->
	-- Based on the CLI's -r formatter from ippclub/YueScript at 6a6fa26d.
	formatter ??= dofile arg[1]
	assert formatter.FormatYue code


const send = (data, raw = false) ->
	if not raw
		data = json.encode(data)::gsub "[\r\n]", ""

	assert type(data) == "string"

	io.stdout::write data, "\n"
	io.stdout::flush!
	return


const recieve = () ->
	const rawData = io.stdin::read "*l"

	const data = if type(rawData) == "string"
		json.decode rawData
	else
		nil

	data, rawData

while true
	const input, rawInput = recieve!

	if input == nil
		send "{}", true
		return

	try
		config = if content := input.config?.content
			try? yue.loadstring(content)!

		configDir = input.config?.dir

		module = input.config?.module ?? "yuescript"

		config ??= {
			lint_global: true
		}

		config.module = module
		config.build = false if config.build == nil
		config.reserve_line_number = false if config.reserve_line_number == nil
		config.reserve_comment = false if config.reserve_comment == nil
		config.lax = true if input.laxCheck == true

		path = config.options?.path ?? ""
		if configDir and config.include and type(config.include) == "table"
			includes = ["#{configDir}/?.lua",]
			for include in *config.include
				if type(include) == "string"
					includes[] = "#{configDir}/#{include}/?.lua"
			path ..= ";" if path ~= ""
			path ..= table.concat includes, ";"

		oldPath = package.path
		package.path ..= ";" .. path

		rewrite = input.isSaveEvent == true and config.build == true and config.rewrite == true
		reserveLineNumber = config.reserve_line_number
		config.reserve_line_number = true if rewrite
		success, messages, transpiledLuaCode = yue.check input.sourceCode, config
		config.reserve_line_number = reserveLineNumber
		realtimeTranspiledLuaCode = nil
		if input.realtimeLua
			_, _, realtimeTranspiledLuaCode = yue.check input.sourceCode, config, true

		package.path = oldPath

		if messages
			:globals = config
			globals = {name, true for name in *globals} if type(globals) == "table"
			messages = [message for message in *messages when message[1] == "error" or (message[1] == "global" and not _G[message[2]] and (not globals or not globals[message[2]]))]
		else
			messages = []

		if rewrite and success and transpiledLuaCode ~= nil
			if rewritten, result := pcall rewriteLua, transpiledLuaCode
				transpiledLuaCode = result
			else
				success = false
				transpiledLuaCode = nil
				messages[] = {"error", "Failed to rewrite Lua output: #{result}", 1, 1}

		send input.isSaveEvent and {
			:success
			:transpiledLuaCode
			:rewrite
			:realtimeTranspiledLuaCode
			include: config.include
			:configDir
			build: config.build
			reserveLineNumber: config.reserve_line_number
			reserveComment: config.reserve_comment
			:messages
		} or {
			:success
			:realtimeTranspiledLuaCode
			build: config.build
			reserveLineNumber: config.reserve_line_number
			reserveComment: config.reserve_comment
			:messages
		}
	catch err
		send
			success: false
			messages: [ ["error", err, 1, 1],]
